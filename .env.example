# Скопируйте на VPS в .env и подставьте свои значения.
# Файл .env в git не попадает. Здесь только имена переменных и примеры.

# Публичное имя сайта. На него выпускается сертификат Let's Encrypt.
DOMAIN=example.com
ACME_EMAIL=you@example.com

# PostgreSQL. Пароль придумайте длинный и храните только на сервере.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=visits

# Строка подключения из контейнера приложения.
# Хост postgres — это имя сервиса в docker-compose, не адрес VPS.
DATABASE_URL=postgresql://app:change-me@postgres:5432/visits

# Образ приложения из GitHub Container Registry.
# OWNER — владелец репозитория на GitHub в нижнем регистре.
APP_IMAGE=ghcr.io/OWNER/docker-vps-deploy:latest
